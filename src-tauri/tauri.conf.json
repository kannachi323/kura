{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kura",
  "version": "0.1.0",
  "identifier": "com.mattdev727.kura",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kura",
        "width": 1200,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 21.5 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$HOME/**", "/Volumes/**", "/media/**", "/mnt/**", "$TEMP/**", "$APPCACHE/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "A fast, private file manager",
    "copyright": "Kura contributors, MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["kura"] }
    },
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/kannachi323/kura/releases/latest/download/latest.json"]
    }
  }
}
